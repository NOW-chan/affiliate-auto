# ローカル／自宅サーバで動かすとき用（cp .env.example .env して値を入れる）
# GitHub Actions では、これらを Settings → Secrets and variables → Actions に登録する

CLAUDE_CODE_OAUTH_TOKEN=

HATENA_ID=nowchan
HATENA_BLOG_DOMAIN=nowchan.hatenablog.com
HATENA_API_KEY=

THREADS_ACCESS_TOKEN=

# X は任意（使う場合のみ）
X_ENABLED=false
X_INCLUDE_LINK=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
